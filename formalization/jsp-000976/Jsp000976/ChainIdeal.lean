module

public import Jsp000976.PaletteMarks
import Mathlib.Order.OrderIsoNat

/-!
# The ideal of sets without an infinite compatible chain

The ground-model argument uses a countable set of candidate slices. A family
of labels is thin if it contains no infinite compatible chain. This ideal
can be enlarged by the old marks whenever every finite union of those
marks misses some infinite compatible chain.
-/

@[expose] public section

namespace Jsp000976

open Set

universe u v

variable {α : Type u}

/-- A chain is indexed in increasing order by the natural numbers. -/
def ContainsChain (r : α → α → Prop) (A : Set α) : Prop :=
  ∃ f : Nat → α, (∀ n, f n ∈ A) ∧ ∀ i j, i < j → r (f i) (f j)

def ChainThin (r : α → α → Prop) (A : Set α) : Prop :=
  ¬ ContainsChain r A

theorem ContainsChain.mono {r : α → α → Prop} {A B : Set α} (hA : ContainsChain r A)
    (hAB : A ⊆ B) : ContainsChain r B := by
  obtain ⟨f, hfA, hf⟩ := hA
  exact ⟨f, fun n => hAB (hfA n), hf⟩

theorem ContainsChain.restrict_indices {r : α → α → Prop} {A : Set α} (f : Nat → α)
    (hf : ∀ i j, i < j → r (f i) (f j)) (hInf : (f ⁻¹' A).Infinite) :
    ContainsChain r A := by
  classical
  let e := @Nat.Subtype.orderIsoOfNat (f ⁻¹' A) hInf.to_subtype
  exact ⟨fun n => f (e n), fun n => (e n).2, fun i j hij => hf _ _ (e.strictMono hij)⟩

theorem ChainThin.of_finite {r : α → α → Prop} (hirrefl : ∀ x, ¬ r x x) {A : Set α}
    (hA : A.Finite) : ChainThin r A := by
  rintro ⟨f, hfA, hf⟩
  have hinj : Function.Injective f := by
    intro i j heq
    rcases lt_trichotomy i j with h | h | h
    · exact (hirrefl (f i) (heq.symm ▸ hf i j h)).elim
    · exact h
    · exact (hirrefl (f j) (heq ▸ hf j i h)).elim
  let := hA.to_subtype
  have : Finite Nat := Finite.of_injective
    (fun n => (⟨f n, hfA n⟩ : A)) (fun _ _ heq => hinj (congrArg Subtype.val heq))
  exact _root_.not_finite Nat

theorem ChainThin.union {r : α → α → Prop} {A B : Set α}
    (hA : ChainThin r A) (hB : ChainThin r B) : ChainThin r (A ∪ B) := by
  classical
  rintro ⟨f, hmem, hf⟩
  by_cases ha : (f ⁻¹' A).Infinite
  · exact hA (ContainsChain.restrict_indices f hf ha)
  by_cases hb : (f ⁻¹' B).Infinite
  · exact hB (ContainsChain.restrict_indices f hf hb)
  have ha' : (f ⁻¹' A).Finite := not_infinite.mp ha
  have hb' : (f ⁻¹' B).Finite := not_infinite.mp hb
  exact Set.infinite_univ ((ha'.union hb').subset fun n _ => hmem n)

namespace RowIdeal

variable {ι : Type v}

/-- The ideal generated by thin sets and a family of marks. Properness follows
from a clean chain for every finite set of marks. -/
noncomputable def chainMarks (r : α → α → Prop) (hirrefl : ∀ x, ¬ r x x)
    (marks : ι → Set α) (clean : ∀ s : Finset ι, ContainsChain r (coveredByMarks marks s)ᶜ) :
    RowIdeal α where
  small A := ∃ s : Finset ι, ∃ t : Set α, ChainThin r t ∧ A ⊆ t ∪ coveredByMarks marks s
  finite_small A hA := ⟨∅, A, ChainThin.of_finite hirrefl hA, fun _ hx => Or.inl hx⟩
  small_of_subset _ _ hAB := fun ⟨s, t, ht, hB⟩ => ⟨s, t, ht, hAB.trans hB⟩
  union_small := by
    classical
    rintro A B ⟨s, t, ht, hA⟩ ⟨s', t', ht', hB⟩
    refine ⟨s ∪ s', t ∪ t', ht.union ht', ?_⟩
    rintro x (hx | hx)
    · rcases hA hx with hx | ⟨i, hi, hxi⟩
      · exact Or.inl (Or.inl hx)
      · exact Or.inr ⟨i, Finset.mem_union_left s' hi, hxi⟩
    · rcases hB hx with hx | ⟨i, hi, hxi⟩
      · exact Or.inl (Or.inr hx)
      · exact Or.inr ⟨i, Finset.mem_union_right s hi, hxi⟩
  univ_not_small := by
    rintro ⟨s, t, ht, hcover⟩
    apply ht ((clean s).mono ?_)
    intro x hx
    rcases hcover (Set.mem_univ x) with hxt | hxm
    · exact hxt
    · exact (hx hxm).elim

theorem chainMarks_thin_small (r : α → α → Prop) (hirrefl : ∀ x, ¬ r x x)
    (marks : ι → Set α) (clean : ∀ s : Finset ι, ContainsChain r (coveredByMarks marks s)ᶜ)
    {A : Set α} (h : ChainThin r A) :
    (chainMarks r hirrefl marks clean).small A :=
  ⟨∅, A, h, fun _ hx => Or.inl hx⟩

theorem chainMarks_generator_small (r : α → α → Prop) (hirrefl : ∀ x, ¬ r x x)
    (marks : ι → Set α) (clean : ∀ s : Finset ι, ContainsChain r (coveredByMarks marks s)ᶜ)
    (i : ι) :
    (chainMarks r hirrefl marks clean).small (marks i) := by
  refine ⟨{i}, ∅, ChainThin.of_finite hirrefl Set.finite_empty, ?_⟩
  exact fun _ hx => Or.inr ⟨i, Finset.mem_singleton_self i, hx⟩

theorem containsChain_of_chainMarks_positive (r : α → α → Prop) (hirrefl : ∀ x, ¬ r x x)
    (marks : ι → Set α) (clean : ∀ s : Finset ι, ContainsChain r (coveredByMarks marks s)ᶜ)
    {A : Set α} (hA : ¬ (chainMarks r hirrefl marks clean).small A) :
    ContainsChain r A := by
  classical
  by_contra h
  exact hA (chainMarks_thin_small r hirrefl marks clean h)

end RowIdeal

end Jsp000976
