module

public import Mathlib.Data.Finset.Card
public import Mathlib.Data.Set.Finite.Basic

/-!
# The row-ideal and minimal-palette arguments for Erdős #1171

These lemmas formalize the last part of §4 in Howe–Huffman–Kohlmeyer–
Kruer, "A finite-color partition relation for ω₁²".
-/

@[expose] public section

namespace Jsp000976

universe u v w

/-- A proper ideal on a row type, containing every finite set. -/
structure RowIdeal (ρ : Type u) where
  small : Set ρ → Prop
  finite_small : ∀ ⦃s⦄, s.Finite → small s
  small_of_subset : ∀ ⦃s t⦄, s ⊆ t → small t → small s
  union_small : ∀ ⦃s t⦄, small s → small t → small (s ∪ t)
  univ_not_small : ¬ small Set.univ

namespace RowIdeal

/-- The ideal of finite sets on an infinite row type. -/
def finite {α : Type u} [Infinite α] : RowIdeal α where
  small := Set.Finite
  finite_small _ h := h
  small_of_subset _ _ h hT := hT.subset h
  union_small _ _ := Set.Finite.union
  univ_not_small := Set.infinite_univ

variable {ρ : Type u} {ι : Type v}

/-- The finitely many mark sets indexed by a finite set cover this union. -/
def coveredByMarks (marks : ι → Set ρ) (s : Finset ι) : Set ρ :=
  {x | ∃ i ∈ s, x ∈ marks i}

theorem no_finite_cover (rows : Set ρ) (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (rows \ coveredByMarks marks s).Infinite)
    {A : Set ρ} (hA : rows ⊆ A) :
    ¬ ∃ s : Finset ι, ∃ t : Set ρ, t.Finite ∧ A ∩ rows ⊆ t ∪ coveredByMarks marks s := by
  rintro ⟨s, t, ht, hcover⟩
  apply h s
  refine ht.subset ?_
  rintro x ⟨hx, hxs⟩
  rcases hcover ⟨hA hx, hx⟩ with hxt | hxm
  · exact hxt
  · exact (hxs hxm).elim

/-- The ideal generated by the marks on a specified row set, viewed as an
ideal on the full row type. -/
noncomputable def generatedOn
    (rows : Set ρ) (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (rows \ coveredByMarks marks s).Infinite) : RowIdeal ρ where
  small A := ∃ s : Finset ι, ∃ t : Set ρ, t.Finite ∧ A ∩ rows ⊆ t ∪ coveredByMarks marks s
  finite_small A hA := ⟨∅, A, hA, fun _ hx => Or.inl hx.1⟩
  small_of_subset _ _ hAB := fun ⟨s, t, ht, hB⟩ => ⟨s, t, ht, fun _ hx => hB ⟨hAB hx.1, hx.2⟩⟩
  union_small := by
    classical
    rintro A B ⟨s, t, ht, hA⟩ ⟨s', t', ht', hB⟩
    refine ⟨s ∪ s', t ∪ t', ht.union ht', ?_⟩
    rintro x ⟨hx | hx, hrows⟩
    · rcases hA ⟨hx, hrows⟩ with hx | ⟨i, hi, hxi⟩
      · exact Or.inl (Or.inl hx)
      · exact Or.inr ⟨i, Finset.mem_union_left s' hi, hxi⟩
    · rcases hB ⟨hx, hrows⟩ with hx | ⟨i, hi, hxi⟩
      · exact Or.inl (Or.inr hx)
      · exact Or.inr ⟨i, Finset.mem_union_right s hi, hxi⟩
  univ_not_small := no_finite_cover rows marks h (Set.subset_univ rows)

theorem generatedOn_rows_not_small
    (rows : Set ρ) (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (rows \ coveredByMarks marks s).Infinite) :
    ¬ (generatedOn rows marks h).small rows :=
  no_finite_cover rows marks h Set.Subset.rfl

theorem generatedOn_generator_small
    (rows : Set ρ) (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (rows \ coveredByMarks marks s).Infinite) (i : ι) :
    (generatedOn rows marks h).small (marks i) := by
  refine ⟨{i}, ∅, Set.finite_empty, ?_⟩
  intro x hx
  exact Or.inr ⟨i, Finset.mem_singleton_self i, hx.1⟩

/-- The ideal generated by the finite sets and a family of marks, provided the
union of any finite subfamily has infinite complement. -/
noncomputable def generated (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (coveredByMarks marks s)ᶜ.Infinite) : RowIdeal ρ :=
  generatedOn Set.univ marks (fun s => by simpa [Set.compl_eq_univ_sdiff] using h s)

theorem generator_small (marks : ι → Set ρ)
    (h : ∀ s : Finset ι, (coveredByMarks marks s)ᶜ.Infinite) (i : ι) :
    (generated marks h).small (marks i) :=
  generatedOn_generator_small _ _ _ i

/-- A finite union of small mark sets belongs to the row ideal. -/
theorem coveredByMarks_small (J : RowIdeal ρ) (marks : ι → Set ρ) (s : Finset ι)
    (h : ∀ i ∈ s, J.small (marks i)) : J.small (coveredByMarks marks s) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    have heq : coveredByMarks marks ∅ = ∅ := by
      ext x
      simp [coveredByMarks]
    rw [heq]
    exact J.finite_small Set.finite_empty
  | @insert i s hi ih =>
    have heq : coveredByMarks marks (insert i s) = marks i ∪ coveredByMarks marks s := by
      ext x
      constructor
      · rintro ⟨j, hj, hmark⟩
        rcases Finset.mem_insert.mp hj with rfl | hj
        · exact Or.inl hmark
        · exact Or.inr ⟨j, hj, hmark⟩
      · rintro (hx | ⟨j, hj, hmark⟩)
        · exact ⟨i, Finset.mem_insert_self i s, hx⟩
        · exact ⟨j, Finset.mem_insert_of_mem hj, hmark⟩
    rw [heq]
    exact J.union_small (h i (Finset.mem_insert_self i s))
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

theorem diff_not_small (J : RowIdeal ρ) {A B : Set ρ}
    (hA : ¬ J.small A) (hB : J.small B) : ¬ J.small (A \ B) := by
  intro hAB
  apply hA
  refine J.small_of_subset ?_ (J.union_small hAB hB)
  intro x hx
  by_cases h : x ∈ B
  · exact Or.inr h
  · exact Or.inl ⟨hx, h⟩

/-- If a positive row set is covered by finitely many fibers, at least one
of the fibers is positive. -/
theorem exists_positive_mark (J : RowIdeal ρ) (marks : ι → Set ρ)
    (s : Finset ι) {A : Set ρ} (hA : ¬ J.small A)
    (hcover : A ⊆ coveredByMarks marks s) :
    ∃ i ∈ s, ¬ J.small (marks i) := by
  classical
  by_contra! h
  exact hA (J.small_of_subset hcover (J.coveredByMarks_small marks s h))

/-- A proper ideal remains proper on any row set outside the ideal. -/
def restrict (J : RowIdeal ρ) (rows : Set ρ) (hrows : ¬ J.small rows) : RowIdeal rows where
  small A := J.small (Subtype.val '' A)
  finite_small _ hA := J.finite_small (hA.image _)
  small_of_subset _ _ hAB := J.small_of_subset (Set.image_mono hAB)
  union_small _ _ hA hB := by
    rw [Set.image_union]
    exact J.union_small hA hB
  univ_not_small := by
    rw [Set.image_univ, Subtype.range_val]
    exact hrows

end RowIdeal

section Palette

variable {ρ : Type u} {Stock : Type v} {Color : Type w}

/-- Among stocks with a positive row set, any initial stock admits a
refinement whose finite palette is minimal across all positive refinements. -/
theorem exists_minimal_palette
    (J : RowIdeal ρ) (refines : Stock → Stock → Prop)
    (hrefl : ∀ A, refines A A)
    (htrans : ∀ A B C, refines A B → refines B C → refines A C)
    (rows : Stock → Set ρ) (palette : Stock → Finset Color)
    (hpalette : ∀ {A B}, refines A B → palette A ⊆ palette B)
    (A : Stock) (hA : ¬ J.small (rows A)) :
    ∃ B, refines B A ∧ ¬ J.small (rows B) ∧
      ∀ C, refines C B → ¬ J.small (rows C) → palette C = palette B := by
  classical
  let P (n : ℕ) := ∃ B, refines B A ∧ ¬ J.small (rows B) ∧ (palette B).card = n
  have hP : ∃ n, P n := ⟨(palette A).card, A, hrefl A, hA, rfl⟩
  obtain ⟨B, hBA, hB, hcB⟩ := Nat.find_spec hP
  refine ⟨B, hBA, hB, fun C hCB hC => ?_⟩
  apply Finset.eq_of_subset_of_card_le (hpalette hCB)
  calc
    (palette B).card = Nat.find hP := hcB
    _ ≤ (palette C).card := Nat.find_min' hP ⟨C, htrans C B A hCB hBA, hC, rfl⟩

/-- On a minimal-palette stock, thick fibers of an internal color belong
to the row ideal whenever taking that fiber gives a refinement avoiding
the color. Triangle exclusion supplies the latter implication. -/
theorem thick_fiber_small_of_minimal_palette
    (J : RowIdeal ρ) (refines : Stock → Stock → Prop)
    (rows : Stock → Set ρ) (palette : Stock → Finset Color)
    (A : Stock) (p : Color) (hp : p ∈ palette A) (fiberRows : Set ρ)
    (hmin : ∀ B, refines B A → ¬ J.small (rows B) → palette B = palette A)
    (hrefine : ¬ J.small fiberRows → ∃ B, refines B A ∧ rows B = fiberRows ∧ p ∉ palette B) :
    J.small fiberRows := by
  classical
  by_contra h
  obtain ⟨B, hBA, hrows, hpB⟩ := hrefine h
  have hB : ¬ J.small (rows B) := hrows ▸ h
  exact hpB ((hmin B hBA hB).symm ▸ hp)

/-- A positive row set with already marked colors can be refined to mark
strictly more colors when its nonempty internal palette avoids the old marks
and the internal-color fibers exclude that color. -/
theorem exists_enlarged_marked_palette
    {Test : Type*}
    (J : RowIdeal ρ) (refines : Stock → Stock → Prop)
    (hrefl : ∀ A, refines A A)
    (htrans : ∀ A B C, refines A B → refines B C → refines A C)
    (rows : Stock → Set ρ) (palette : Stock → Finset Color)
    (hpalette : ∀ {A B}, refines A B → palette A ⊆ palette B)
    (mark : Stock → Test → Color → Set ρ)
    (hmark_mono : ∀ {A B}, refines A B → ∀ y p, mark A y p ⊆ mark B y p)
    (A : Stock) (hA : ¬ J.small (rows A)) (L : Finset Color)
    (hweight : ∀ B, refines B A → ∀ y p, ¬ J.small (mark B y p) →
      ∃ C, refines C B ∧ rows C = mark B y p ∧ p ∉ palette C)
    (hold : ∀ y p, p ∈ L → J.small (mark A y p))
    (havoid : ∀ p, p ∈ palette A → p ∉ L)
    (hused : ∀ B, refines B A → ¬ J.small (rows B) → (palette B).Nonempty) :
    ∃ B M, refines B A ∧ ¬ J.small (rows B) ∧ L ⊆ M ∧ L.card < M.card ∧
      (∀ p ∈ M, p ∈ L ∨ p ∈ palette B) ∧
      ∀ y p, p ∈ M → J.small (mark B y p) := by
  classical
  obtain ⟨B, hBA, hB, hmin⟩ :=
    exists_minimal_palette J refines hrefl htrans rows palette hpalette A hA
  obtain ⟨p, hp⟩ := hused B hBA hB
  have hstrict : L ⊂ L ∪ palette B := by
    refine Finset.ssubset_iff_subset_ne.mpr ⟨Finset.subset_union_left, ?_⟩
    intro heq
    exact havoid p (hpalette hBA hp) (heq.symm ▸ Finset.mem_union_right L hp)
  refine ⟨B, L ∪ palette B, hBA, hB, Finset.subset_union_left, Finset.card_lt_card hstrict,
    fun _ hp => Finset.mem_union.mp hp, ?_⟩
  intro y q hq
  rcases Finset.mem_union.mp hq with hq | hq
  · exact J.small_of_subset (hmark_mono hBA y q) (hold y q hq)
  · exact thick_fiber_small_of_minimal_palette J refines rows palette B q hq
      (mark B y q) hmin (hweight B hBA y q)

end Palette

end Jsp000976
